# ── Database (local XAMPP MariaDB; matches the backend's Prisma DB) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jobhighlander

# ── Browser / stealth ──
HEADLESS=false
# Optional pinned user-agent (leave blank to use the installed Chrome's own UA)
USER_AGENT=
TIMEZONE=America/New_York
# Proxy: leave blank for direct IP. Format: http://user:pass@host:port
PROXY_URL=

# ── Human-like pacing (seconds) — Indeed is sensitive, keep these generous ──
MIN_ACTION_DELAY=0.6
MAX_ACTION_DELAY=2.2
MIN_PAGE_DELAY=2.5
MAX_PAGE_DELAY=6.0

# ── Indeed scraper ──
INDEED_SEARCH_URL=https://www.indeed.com/q-us-remote-jobs.html
MAX_JOBS=25
FETCH_DESCRIPTIONS=true
# Filled in later when you provide sign-in details
INDEED_EMAIL=
INDEED_PASSWORD=

# ── Scheduler: random gap between runs (hours) ──
SCHEDULE_MIN_HOURS=1
SCHEDULE_MAX_HOURS=3

LOG_LEVEL=INFO
